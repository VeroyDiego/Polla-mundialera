# Postgres (Neon/Supabase free tier o local)
DATABASE_URL="postgresql://user:password@localhost:5432/polla_mundial_26"

# Puerto del servidor Express
PORT=4000

# Origen permitido para CORS (URL del frontend)
CLIENT_ORIGIN="http://localhost:5173"

# Contraseña compartida del panel de organizador (se hashea al iniciar)
ADMIN_PASSWORD="cambia-esta-clave"

# Proveedor de fixtures: "football-data" (default) u "openfootball"
FIXTURES_PROVIDER=football-data

# Token de football-data.org (https://www.football-data.org/client/register)
FOOTBALL_DATA_API_TOKEN=""

# Cada cuántos minutos corre el job de sincronización
SYNC_INTERVAL_MINUTES=45

# Código de competencia del Mundial en football-data.org
FOOTBALL_DATA_COMPETITION_CODE=WC
